# 将需要的 NapCat 设置加入项目已有 .env，模型设置继续由 Agent 自己管理。
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_TOKEN=replace_with_your_napcat_network_token
# 首次启动全部会话关闭，在聊天配置页手动启用。
NAPCAT_GUI=1
# 可选：一键自动配置时优先查找的本机NapCat目录（或onebot11_账号.json完整路径）。
# NAPCAT_CONFIG_DIR=D:/NapCat/config
# GUI 中允许列表仅预填关闭的会话；以下过滤规则用于无界面模式。
NAPCAT_ALLOW_GROUPS=123456,234567
NAPCAT_GROUP_ONLY=1
NAPCAT_REQUIRE_AT=0
NAPCAT_API_TIMEOUT=15
NAPCAT_RECONNECT_DELAY=3
NAPCAT_INBOX_CAPACITY=500
