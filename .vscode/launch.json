{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Amber-AGENT：启动主程序",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/agent/.env",
            "env": {
                "PYTHONIOENCODING": "utf-8",
                "PYTHONUNBUFFERED": "1",
                "PYTHONDONTWRITEBYTECODE": "1"
            },
            "justMyCode": true,
            "subProcess": false
        }
    ]
}
